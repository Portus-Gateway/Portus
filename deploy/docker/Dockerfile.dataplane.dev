# syntax=docker/dockerfile:1.7
FROM rust:1.98-alpine AS builder

RUN apk add --no-cache musl-dev cmake make perl build-base protoc

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY proto/ proto/

# BuildKit cache mounts keep the cargo registry and the target dir between
# builds, so a code change recompiles only the crates that changed instead of
# the whole dependency graph (~30 min cold on a laptop, seconds warm).
# Each binary gets its own target cache so parallel builds do not block.
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=cargo-target-dataplane-debug,target=/src/target \
    cargo build -p portus-dataplane \
    && mkdir -p /out && cp /src/target/debug/portus-dataplane /out/portus-dataplane

FROM alpine:3.21

COPY --from=builder /out/portus-dataplane /dataplane
COPY --from=builder --chown=1000:1000 /tmp /tmp

USER 1000

EXPOSE 80 443 8081 9090
ENTRYPOINT ["/dataplane"]
